# MongoDB connection (must be a replica set for change streams)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=tts_service

# NATS messaging
NATS_URI=nats://localhost:4222

# PulseAudio (Linux only)
PULSE_SERVER=unix:/run/user/1000/pulse/native
VIRTUAL_MIC=virtual_mic

# Piper TTS model path
PIPER_MODEL_PATH=/app/models/piper/en_US-amy-medium.onnx

# Logging
LOG_LEVEL=INFO
